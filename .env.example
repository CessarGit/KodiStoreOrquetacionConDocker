# =============================================================================
#  Copia este archivo:  cp .env.example .env   y cambia TODOS los secretos.
#  .env NUNCA se sube a git ni entra a las imágenes (.dockerignore).
# =============================================================================

# --- Versionado de imágenes (Build -> Tag -> Push -> Pull -> Run) ---
# Prefijo de las imágenes: tu usuario de Docker Hub o la URL de tu registry
REGISTRY=bootcamp
# Versión con la que se etiquetan las imágenes
TAG=1.0.0

# --- Versiones de imágenes base ---
# Node y MySQL: las que recomienda la actividad. Ambas dejaron de recibir
# parches en abril de 2026; para producción real usa 24-alpine y 8.4.
NODE_VERSION=20-alpine
# PHP: la actividad pide 8.2 o superior, pero composer.lock exige >= 8.4.1.
PHP_VERSION=8.4
MYSQL_VERSION=8.0

# --- Puertos publicados en el host ---
# Los puertos internos no cambian: Next.js 3000, Nginx 80
FRONTEND_PORT=3000
# Si cambias API_PORT, cambia también NEXT_PUBLIC_API_BASE_URL y APP_URL
API_PORT=8000

# --- Frontend ---
# URL de la API vista desde el NAVEGADOR. Se incrusta en el build: si la
# cambias, reconstruye con  docker compose up -d --build frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# --- Laravel ---
# Nombre de la aplicación
APP_NAME=KodiStoreAPI
# URL pública de la API
APP_URL=http://localhost:8000
# Orígenes permitidos por CORS (varios separados por coma). También se incrusta
# en el frontend como URL de la aplicación (NEXT_PUBLIC_APP_URL).
FRONTEND_URL=http://localhost:3000
# OBLIGATORIA. Clave de cifrado de Laravel.
# Genera una con:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Nivel mínimo de log: debug, info, notice, warning, error...
LOG_LEVEL=warning
# Dónde se guardan caché y sesiones (file = dentro del contenedor)
CACHE_STORE=file
SESSION_DRIVER=file
# sync = las tareas se ejecutan al momento, sin un worker aparte
QUEUE_CONNECTION=sync
# true = ejecuta las migraciones cada vez que arranca el contenedor
RUN_MIGRATIONS=true
# Algoritmo de hashing de contraseñas (igual que en desarrollo)
HASH_DRIVER=argon2id

# --- JWT (autenticación de la API) ---
# OBLIGATORIA. Clave con la que se firman los tokens.
# Genera una con:  openssl rand -base64 48
JWT_SECRET=
# Algoritmo de firma
JWT_ALGO=HS256

# --- Stripe (opcional; claves de prueba) ---
# Clave pública (pk_test_...)
STRIPE_KEY=
# Clave secreta (sk_test_...)
STRIPE_SECRET=
# Secreto de firma de los webhooks (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- MySQL (las cuatro son OBLIGATORIAS) ---
# Se aplican solo en el primer arranque, con el volumen vacío.
# Contraseña del usuario root
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
# Base de datos que se crea al iniciar
MYSQL_DATABASE=ecommerce
# Usuario con el que se conecta Laravel, y su contraseña
MYSQL_USER=bootcamp_user
MYSQL_PASSWORD=cambia_esta_clave_app
