# ANTES: Dockerfile "básico" (una sola etapa) — solo para comparar.
# Problemas: imagen Debian completa, compiladores y Composer quedan en la imagen,
# dependencias de desarrollo instaladas, .git/.env pueden colarse,
# `artisan serve` (servidor de desarrollo) y ejecución como root.
FROM php:8.4-cli
RUN apt-get update && apt-get install -y git unzip libzip-dev \
 && docker-php-ext-install pdo_mysql zip
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app
COPY . .
RUN composer install
EXPOSE 8000
CMD ["php", "artisan", "serve", "--host=0.0.0.0", "--port=8000"]
